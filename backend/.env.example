# Production: copy to .env (gitignored) and fill real values. Never commit secrets.
NODE_ENV=production
PORT=3000
FRONTEND_ORIGIN=https://www.usscos.org,https://usscos.org,http://localhost:5173

FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

PRIVATE_STORAGE_PATH=./storage/private

# Optional: Cloudflare Turnstile secret for deep anti-spam checks on order creation.
# Empty = token presence is required but not verified remotely.
TURNSTILE_SECRET=

# Optional: whole-INR bounds for payment orders (defaults 1 - 1000000).
MIN_AMOUNT_INR=1
MAX_AMOUNT_INR=1000000
