# Apache fallback for the Vite SPA (Hostinger static hosting).
# Netlify-style _redirects/_headers are NOT read by Apache; this file is
# their equivalent here. Safe to keep alongside them (each host reads only
# its own convention).

<IfModule mod_rewrite.c>
  RewriteEngine On

  # SPA fallback: route non-file, non-directory requests to index.html so
  # deep links (/admin/*, /news/*, /payment/*, …) resolve client-side.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
  # Must match public/_headers (Netlify) — keep the two files in sync.
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
