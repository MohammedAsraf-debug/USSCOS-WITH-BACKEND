# Firebase SDK
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Admin bootstrap: comma-separated emails allowed to become the first SUPER_ADMIN.
VITE_ADMIN_ALLOWED_EMAILS=

# Site
VITE_SITE_URL=http://localhost:5173

# Environment: dev | production
VITE_ENV=dev

# Unified Node.js backend (applications + payments + private documents).
# Single source — no per-service URLs.
# Example: VITE_BACKEND_URL=https://api.example.com
VITE_BACKEND_URL=

# Frontend-safe Razorpay Key ID (public TEST key, e.g. rzp_test_...). Must be
# the SAME key the backend RAZORPAY_KEY_ID holds — Checkout opens with this
# key and aborts on mismatch. NEVER put RAZORPAY_KEY_SECRET (or any backend
# secret) in a VITE_* variable.
VITE_RAZORPAY_KEY_ID=

# Cloudinary media hosting (admin gallery uploads). The cloud name is public and
# the upload preset must be an UNSIGNED preset — no API secret ever reaches the
# browser. Empty = admin media uploads are disabled (no Firebase Storage used).
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
